{
  "name": "@quartz-community/page-title",
  "version": "0.1.0",
  "description": "Base-path-aware GrappleGraph page title component for Quartz.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --check",
    "check": "npm run typecheck && npm run format && npm test"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/types": "^0.2.1"
  },
  "devDependencies": {
    "preact": "^10.28.2",
    "preact-render-to-string": "^6.6.5",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "quartz": {
    "name": "page-title",
    "displayName": "Page Title",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "PageTitle": {
        "displayName": "Page Title",
        "defaultPosition": "left",
        "defaultPriority": 10
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  }
}
