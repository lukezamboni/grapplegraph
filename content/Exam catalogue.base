filters:
  and:
    - file.inFolder("techniques")
    - or:
        - file.hasTag("exam/blue-belt")
        - file.hasTag("exam/purple-belt")
        - file.hasTag("exam/brown-belt-only")
formulas:
  technique: link(file.path, note.title)
  belt_label: |
    if(file.hasTag("exam/blue-belt"), "Blue",
    if(file.hasTag("exam/purple-belt"), "Purple", "Brown-only"))
  family_label: |
    if(file.hasTag("family/self-defence"), "Self-defence",
    if(file.hasTag("family/half-guard"), "Half guard",
    if(file.hasTag("family/guard-passing"), "Guard passing",
    if(file.hasTag("family/sweep"), "Sweeps",
    if(file.hasTag("family/takedown"), "Takedowns",
    if(file.hasTag("family/guard-transition"), "Guard attacks and transitions", note.family))))))
  verification: if(note.instructor_verified, "Verified", "Needs instructor review")
  video_reference: if(file.hasProperty("video_match"), note.video_match, "representative")
properties:
  formula.technique:
    displayName: Technique
  formula.belt_label:
    displayName: Belt
  exam_id:
    displayName: Exam order
  source_exam_id:
    displayName: Source number
  formula.family_label:
    displayName: Family
  start:
    displayName: Starts from
  finish:
    displayName: Finish
  video_match:
    displayName: Video match
  formula.verification:
    displayName: Academy check
  formula.video_reference:
    displayName: Video reference
views:
  - type: table
    name: All belts
    groupBy:
      property: formula.belt_label
      direction: ASC
    order:
      - formula.technique
      - formula.belt_label
      - exam_id
      - formula.family_label
      - finish
    sort:
      - property: formula.belt_label
        direction: ASC
      - property: exam_id
        direction: ASC
    columnSize:
      formula.technique: 340
      formula.belt_label: 110
      exam_id: 90
      formula.family_label: 210
      finish: 170
  - type: table
    name: Blue belt
    filters:
      and:
        - file.hasTag("exam/blue-belt")
    order:
      - formula.technique
      - exam_id
      - formula.family_label
      - start
      - finish
      - video_match
      - formula.verification
    sort:
      - property: exam_id
        direction: ASC
  - type: table
    name: Purple belt
    filters:
      and:
        - file.hasTag("exam/purple-belt")
    order:
      - formula.technique
      - exam_id
      - source_exam_id
      - formula.family_label
      - start
      - finish
      - formula.verification
    sort:
      - property: exam_id
        direction: ASC
  - type: table
    name: Brown-only
    filters:
      and:
        - file.hasTag("exam/brown-belt-only")
    order:
      - formula.technique
      - exam_id
      - source_exam_id
      - formula.family_label
      - start
      - finish
      - formula.verification
    sort:
      - property: exam_id
        direction: ASC
  - type: table
    name: By family
    groupBy:
      property: formula.family_label
      direction: ASC
    order:
      - formula.technique
      - formula.belt_label
      - exam_id
      - formula.family_label
      - start
      - finish
    sort:
      - property: formula.family_label
        direction: ASC
      - property: formula.belt_label
        direction: ASC
      - property: exam_id
        direction: ASC
  - type: table
    name: Video references
    groupBy:
      property: formula.video_reference
      direction: ASC
    order:
      - formula.technique
      - formula.belt_label
      - formula.video_reference
      - formula.family_label
      - formula.verification
    sort:
      - property: formula.video_reference
        direction: ASC
      - property: formula.belt_label
        direction: ASC
      - property: exam_id
        direction: ASC
  - type: list
    name: Quick scan
    order:
      - formula.technique
      - formula.belt_label
      - exam_id
      - formula.family_label
      - start
      - finish
    sort:
      - property: formula.belt_label
        direction: ASC
      - property: exam_id
        direction: ASC
    limit: 60
